# Copy to .env.local and fill in real values.

# GitHub OAuth app credentials.
# Create at https://github.com/settings/developers with:
#   Homepage URL:               http://localhost:3001
#   Authorization callback URL: http://localhost:3001/api/auth/callback/github
# Port 3001, not 3000 — 3000 is occupied by another local project.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Base URL of the Go recsys API.
RECSYS_API_URL=http://localhost:8081
