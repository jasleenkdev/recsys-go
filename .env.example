# Phase C: all service endpoints are configured here.
# Copy to .env and adjust for your machine:  cp .env.example .env
#
# Every variable is optional — internal/config falls back to the value
# shown here, which is the local-dev default. Set them explicitly in a
# hosted environment, where no .env file exists at all.

# Postgres DSN. Used by every binary (api, consumer, loader, promote,
# promote-qdrant, test-candidates).
DATABASE_URL=postgres://jasleenkaur@localhost:5432/recsys?sslmode=disable

# Qdrant base URL, no trailing slash. Serves both the repo_embeddings
# collection (recommendations) and readme_chunks (RAG search).
# Port 6343, not Qdrant's default 6333, because of a local port conflict
# with an unrelated Docker stack.
QDRANT_URL=http://localhost:6343

# Redis host:port. Backs the recommendation snapshot-cursor sessions.
REDIS_ADDR=localhost:6390

# Kafka broker list, comma-separated. Carries the repo-events topic
# between the API (producer) and the consumer.
KAFKA_BROKERS=localhost:9092

# Embedding sidecar /embed endpoint. Turns text into vectors for both
# ingestion (promote) and query time (search).
EMBED_SIDECAR_URL=http://localhost:8000/embed

# Ollama /api/generate endpoint. Writes the grounded answer in
# POST /v1/recommendations/search.
OLLAMA_URL=http://localhost:11434/api/generate

# Port the HTTP API listens on.
API_PORT=8081
